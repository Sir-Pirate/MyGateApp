<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet + Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- MAIN LOGIN -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- REGISTER -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- ADMIN HOME -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- GUARD HOME -->
        <activity
            android:name=".GuardHomeActivity"
            android:exported="false" />

        <!-- RESIDENT HOME -->
        <activity
            android:name=".ResidentHomeActivity"
            android:exported="false" />

        <!-- VISITOR MODULES -->
        <activity
            android:name=".VisitorApproveActivity"
            android:exported="false" />

        <activity
            android:name=".VisitorArrivalActivity"
            android:exported="false" />

        <activity
            android:name=".VisitorAuthActivity"
            android:exported="false" />

        <!-- DELIVERY -->
        <activity
            android:name=".DeliveryLogActivity"
            android:exported="false" />

        <!-- STAFF -->
        <activity
            android:name=".StaffCheckInActivity"
            android:exported="false" />

        <!-- ALERTS -->
        <activity
            android:name=".AlertsActivity"
            android:exported="false" />

        <!-- OPTIONAL MODULES -->
        <!-- ONLY UNCOMMENT WHEN THESE FILES EXIST -->
        <!--
        <activity
            android:name=".ResidentsDirectoryActivity"
            android:exported="false" />

        <activity
            android:name=".ParkingActivity"
            android:exported="false" />

        <activity
            android:name=".NoticesActivity"
            android:exported="false" />

        <activity
            android:name=".SOSActivity"
            android:exported="false" />
        -->

        <!-- FIREBASE CLOUD MESSAGING -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

    </application>

</manifest>