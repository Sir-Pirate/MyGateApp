<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <!-- ONLY ONE CHILD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ───────── HEADER ───────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A237E"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MyGate"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textColor="#C5CAE9"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon, 14 Apr"
                android:textColor="#9FA8DA"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ───────── QUICK ACTIONS ───────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:id="@+id/btnGoToVisitorApprove"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="Pre-Approve"
                        android:textStyle="bold"  android:layout_height="wrap_content"
                        android:layout_width="wrap_content" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:id="@+id/btnGoToVisitorArrival"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="Visitor Arrival"
                        android:textStyle="bold"  android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ───────── FEATURES GRID ───────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnVisitorAuth"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Visitor Auth" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDelivery"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Delivery" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnStaff"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Staff Entry" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnAlerts"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Alerts" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnResidents"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Residents" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnNotices"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Notices" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnMyProfile"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Profile" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnParking"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:layout_margin="4dp">
                    <TextView android:text="Parking" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSOS"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#FFEBEE"
                    android:layout_margin="4dp">
                    <TextView android:text="SOS" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ───────── LOGOUT ───────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="16dp"
            android:text="Logout"
            android:textColor="#FFFFFF"
            app:backgroundTint="#C62828"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>