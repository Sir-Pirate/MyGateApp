<?xml version="1.0" encoding="utf-8"?>
<ScrollView

    xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="match_parent"

    android:background="@color/brand_primary"

    android:fillViewport="true">

    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="28dp"

        android:paddingEnd="28dp"

        android:paddingTop="60dp"

        android:paddingBottom="40dp">

        <!-- HEADER -->
        <ImageView

            android:layout_width="48dp"

            android:layout_height="48dp"

            android:layout_marginBottom="12dp"

            android:contentDescription="Staff icon"

            android:src="@android:drawable/ic_menu_recent_history"

            app:tint="@color/text_on_dark" />

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Staff Attendance"

            android:textColor="@color/text_on_dark"

            android:textSize="30sp"

            android:textStyle="bold" />

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:layout_marginBottom="32dp"

            android:text="Search staff to mark login or logout"

            android:textColor="@color/text_on_dark_dim"

            android:textSize="13sp" />

        <!-- SECTION LABEL -->
        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginBottom="12dp"

            android:letterSpacing="0.08"

            android:text="FIND STAFF"

            android:textColor="@color/text_on_dark_dim"

            android:textSize="12sp"

            android:textStyle="bold" />

        <!-- Phone label -->
        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginBottom="6dp"

            android:text="Staff Phone Number *"

            android:textColor="@color/text_on_dark"

            android:textSize="13sp"

            android:textStyle="bold" />

        <!-- Phone input -->
        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/tilStaffPhone"

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            app:boxStrokeColor="@color/brand_primary_light"

            app:hintTextColor="@color/brand_primary_light"

            app:startIconDrawable="@android:drawable/ic_menu_call"

            app:startIconTint="@color/brand_primary_light">

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/etStaffPhone"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:hint="Enter staff's 10-digit number"

                android:inputType="phone"

                android:maxLength="10"

                android:textColor="@color/text_on_dark"

                android:textColorHint="@color/text_on_dark_dim"

                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Search Button (primary) -->
        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnSearchStaff"

            android:layout_width="match_parent"

            android:layout_height="52dp"

            android:layout_marginBottom="16dp"

            android:text="Search Staff"

            android:textColor="@color/text_on_dark"

            android:textSize="16sp"

            android:textStyle="bold"

            app:backgroundTint="@color/brand_primary_dark"

            app:cornerRadius="12dp" />

        <!-- LOADING INDICATOR -->
        <ProgressBar

            android:id="@+id/progressBarStaff"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_gravity="center"

            android:layout_marginBottom="12dp"

            android:indeterminateTint="@color/text_on_dark"

            android:visibility="gone" />

        <!-- STATUS MESSAGE -->
        <TextView

            android:id="@+id/tvStatus"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginBottom="16dp"

            android:gravity="center"

            android:padding="12dp"

            android:text=""

            android:textColor="@color/text_on_dark"

            android:textSize="14sp"

            android:visibility="gone" />

        <!-- RESULT CARD (outlined dark card) -->
        <androidx.cardview.widget.CardView

            android:id="@+id/cardStaffResult"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:visibility="gone"

            app:cardBackgroundColor="@color/brand_primary_dark"

            app:cardCornerRadius="12dp"

            app:cardElevation="0dp"

            app:strokeColor="@color/brand_primary_light"

            app:strokeWidth="1dp">

            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <!-- Avatar + Name row -->
                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView

                        android:layout_width="48dp"

                        android:layout_height="48dp"

                        app:cardBackgroundColor="@color/brand_primary"

                        app:cardCornerRadius="24dp"

                        app:cardElevation="0dp"

                        app:strokeColor="@color/brand_primary_light"

                        app:strokeWidth="1dp">

                        <TextView

                            android:id="@+id/tvStaffAvatar"

                            android:layout_width="match_parent"

                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:text="S"

                            android:textColor="@color/text_on_dark"

                            android:textSize="20sp"

                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_marginStart="14dp"

                        android:layout_weight="1"

                        android:orientation="vertical">

                        <TextView

                            android:id="@+id/tvStaffName"

                            android:layout_width="match_parent"

                            android:layout_height="wrap_content"

                            android:text="Staff Name"

                            android:textColor="@color/text_on_dark"

                            android:textSize="16sp"

                            android:textStyle="bold" />

                        <TextView

                            android:id="@+id/tvStaffDetails"

                            android:layout_width="match_parent"

                            android:layout_height="wrap_content"

                            android:layout_marginTop="2dp"

                            android:text="Role · Phone"

                            android:textColor="@color/text_on_dark_dim"

                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View

                    android:layout_width="match_parent"

                    android:layout_height="1dp"

                    android:layout_marginTop="16dp"

                    android:layout_marginBottom="16dp"

                    android:alpha="0.4"

                    android:background="@color/brand_primary_light" />

                <!-- Status row: label + pill -->
                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">

                    <TextView

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="Current Status"

                        android:textColor="@color/text_on_dark_dim"

                        android:textSize="13sp" />

                    <TextView

                        android:id="@+id/tvStaffStatus"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:background="@color/brand_primary"

                        android:paddingStart="12dp"

                        android:paddingTop="4dp"

                        android:paddingEnd="12dp"

                        android:paddingBottom="4dp"

                        android:text="—"

                        android:textColor="@color/text_on_dark"

                        android:textSize="12sp"

                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Mark Login Button (filled green = positive action) -->
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnLoginStaff"

                    android:layout_width="match_parent"

                    android:layout_height="52dp"

                    android:layout_marginTop="20dp"

                    android:text="✓  Mark Login"

                    android:textColor="@color/text_on_dark"

                    android:textSize="16sp"

                    android:textStyle="bold"

                    app:backgroundTint="@color/status_green"

                    app:cornerRadius="12dp" />

                <!-- Mark Logout Button (outlined = secondary action) -->
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnLogoutStaff"

                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                    android:layout_width="match_parent"

                    android:layout_height="48dp"

                    android:layout_marginTop="8dp"

                    android:text="↩  Mark Logout"

                    android:textColor="@color/text_on_dark"

                    android:textSize="14sp"

                    app:cornerRadius="12dp"

                    app:strokeColor="@color/brand_primary_light" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

