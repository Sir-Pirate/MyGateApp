<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- HEADER (matches login: title + tagline directly on brand_primary) -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Arrival icon"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="@color/text_on_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visitor Arrival"
            android:textColor="@color/text_on_dark"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"
            android:text="Enter visitor's phone to verify and log entry"
            android:textColor="@color/text_on_dark_dim"
            android:textSize="13sp" />

        <!-- VERIFY VISITOR SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"
            android:text="VERIFY VISITOR"
            android:textColor="@color/text_on_dark_dim"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Phone label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Visitor Phone Number *"
            android:textColor="@color/text_on_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Phone input (matches login's outlined input) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilArrivalPhone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/brand_primary_light"
            app:hintTextColor="@color/brand_primary_light"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            app:startIconTint="@color/brand_primary_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArrivalPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter visitor's 10-digit number"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="@color/text_on_dark"
                android:textColorHint="@color/text_on_dark_dim"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Check Approval Button (matches login's primary button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckApproval"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:text="Check Approval Status"
            android:textColor="@color/text_on_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary_dark"
            app:cornerRadius="12dp" />

        <!-- LOADING INDICATOR -->
        <ProgressBar
            android:id="@+id/progressBarArrival"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:indeterminateTint="@color/text_on_dark"
            android:visibility="gone" />

        <!-- STATUS / FEEDBACK MESSAGE -->
        <TextView
            android:id="@+id/tvArrivalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/text_on_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- RESULT CARD — shown after lookup (outlined dark card) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVisitorResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_overlay"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Section header with success indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/status_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visitor Found"
                        android:textColor="@color/text_on_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Name"
                        android:textColor="@color/text_on_dark_dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvFoundVisitorName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="—"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status"
                        android:textColor="@color/text_on_dark_dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvApprovalStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="—"
                        android:textColor="@color/status_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Approved By -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Approved By"
                        android:textColor="@color/text_on_dark_dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvApprovedBy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="—"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:alpha="0.4"
                    android:background="@color/brand_primary_light" />

                <!-- Mark Arrival Button (filled green for positive confirmation) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkArrival"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="✓  Mark Visitor as Arrived"
                    android:textColor="@color/text_on_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_green"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Back Button (matches login's outlined secondary button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArrivalBackToHome"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Back to Home"
            android:textColor="@color/text_on_dark"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/card_stroke" />

    </LinearLayout>
</ScrollView>