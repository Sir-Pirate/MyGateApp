<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B71C1C"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📢  Post Alert"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Notify the entire community"
                android:textColor="#EF9A9A"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Alert Type Selector -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alert Type *"
                    android:textColor="#37474F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Type buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- SOS -->
                    <LinearLayout
                        android:id="@+id/btnTypeSOSSelect"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/type_selected_bg"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🆘" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SOS" android:textColor="#B71C1C"
                            android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Announcement -->
                    <LinearLayout
                        android:id="@+id/btnTypeAnnouncementSelect"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/type_unselected_bg"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📢" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Announce" android:textColor="#78909C"
                            android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Maintenance -->
                    <LinearLayout
                        android:id="@+id/btnTypeMaintenanceSelect"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/type_unselected_bg"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔧" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Maintenance" android:textColor="#78909C"
                            android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Title -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Alert Title *" android:textColor="#37474F"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAlertTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#B71C1C" app:hintTextColor="#B71C1C">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAlertTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Water outage in Block A"
                        android:inputType="textCapSentences"
                        android:textColor="#212121" android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Message -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Message *" android:textColor="#37474F"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAlertMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#B71C1C" app:hintTextColor="#B71C1C">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAlertMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Describe the alert in detail..."
                        android:inputType="textMultiLine|textCapSentences"
                        android:lines="3"
                        android:gravity="top"
                        android:textColor="#212121" android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Flat Number (optional) -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Your Flat Number (Optional)" android:textColor="#37474F"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAlertFlat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#B71C1C" app:hintTextColor="#B71C1C">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAlertFlat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 4B"
                        android:inputType="text"
                        android:textColor="#212121" android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Status -->
        <TextView
            android:id="@+id/tvPostAlertStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:padding="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBarPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Post Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitAlert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:text="Post Alert"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#B71C1C"
            app:cornerRadius="12dp" />

        <!-- Cancel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            android:text="Cancel"
            android:textColor="#78909C"
            app:backgroundTint="#ECEFF1"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
